<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?attr/textPrimary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/subtitle"
                android:textColor="?attr/textSecondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/style_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/modeBackground"
                android:contentDescription="@string/style_prev_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="@string/style_prev"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/theme_toggle"
                android:layout_width="68dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/modeBackground"
                android:contentDescription="@string/theme_toggle_desc"
                android:stateListAnimator="@null"
                android:text="@string/theme_follow"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/style_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/modeBackground"
                android:contentDescription="@string/style_next_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="@string/style_next"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pendulum_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/panelBackground"
        android:minHeight="150dp">

        <com.nikon.metronome.PendulumView
            android:id="@+id/pendulum_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mode_title" />

        <com.nikon.metronome.Qianli3DView
            android:id="@+id/qianli3d_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/control_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/panelBackground"
        android:orientation="vertical">

        <include
            layout="@layout/control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/control_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
