<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:bottom="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/taiji_track_bg" />
            <stroke android:width="1dp" android:color="@color/taiji_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="8dp"
        android:left="2dp"
        android:right="2dp"
        android:top="8dp">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:endColor="@color/taiji_track_progress_end" android:startColor="@color/taiji_track_progress_start" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
