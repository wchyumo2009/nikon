<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="@color/taiji_mode_selected_end" android:startColor="@color/taiji_mode_selected_start" />
            <stroke android:width="1dp" android:color="@color/taiji_jade" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="@color/taiji_button_end" android:startColor="@color/taiji_button_start" />
            <stroke android:width="1dp" android:color="@color/taiji_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
