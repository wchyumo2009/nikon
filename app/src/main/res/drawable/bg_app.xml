<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/bg_grad_center"
                android:endColor="@color/bg_grad_end"
                android:startColor="@color/bg_grad_start" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.88"
                android:centerY="0.06"
                android:endColor="@color/glow_sun_end"
                android:gradientRadius="700dp"
                android:startColor="@color/glow_sun_start"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="0.95"
                android:endColor="@color/glow_sky_end"
                android:gradientRadius="650dp"
                android:startColor="@color/glow_sky_start"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
