<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#EAF7FF"
                android:endColor="#E7FAF0"
                android:startColor="#FFF7E4" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:height="240dp"
        android:right="-70dp"
        android:top="-80dp"
        android:width="240dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFD66B"
                android:startColor="#66FFD66B" />
        </shape>
    </item>
    <item
        android:bottom="-110dp"
        android:gravity="bottom|start"
        android:height="280dp"
        android:left="-80dp"
        android:width="280dp">
        <shape android:shape="oval">
            <solid android:color="#224C9AFF" />
        </shape>
    </item>
</layer-list>
