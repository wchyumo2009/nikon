<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#FFA23D" android:startColor="#FFDA6B" />
            <stroke android:width="1.5dp" android:color="@color/sun_orange" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#F0F8FF" android:startColor="#FFFFFF" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
